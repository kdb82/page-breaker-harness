{
  "manifest_version": 3,
  "name": "Page Siege",
  "version": "1.0.0",
  "description": "A tiny soldier who can jump across and blast apart the current page.",
  "action": {
    "default_title": "Toggle Page Siege"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting"],
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
